# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session signing secret — used to HMAC-sign the admin_session cookie so it
# cannot be forged. If unset, falls back to SUPABASE_SERVICE_ROLE_KEY. Set an
# explicit long random value in production (rotating it logs everyone out).
SESSION_SECRET=generate-a-long-random-string

# Encryption key for the Infloww API key, which is stored AES-GCM-encrypted at
# rest in the infloww_config table. If unset, falls back to
# SUPABASE_SERVICE_ROLE_KEY. Set an explicit long random value in production —
# rotating it makes the already-stored key undecryptable, so re-save the key in
# Revenue → Settings after rotating.
INFLOWW_KEY_ENC_SECRET=generate-a-long-random-string

# Cron secret — REQUIRED for the cron routes (/api/cron/*) to run. Vercel Cron
# automatically sends `Authorization: Bearer <CRON_SECRET>`. The cron routes
# fail CLOSED (reject every request) when this is unset.
CRON_SECRET=generate-a-long-random-string

# Upstash Redis (rate limiting for login / track / redirect). Without these the
# rate limiters fail open (become no-ops), so set them in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Your main app domain (without https:// — used to identify admin vs custom domain traffic)
NEXT_PUBLIC_APP_DOMAIN=yourdomain.com

# Admin accounts live in the `admin_users` table (email + password set on first
# login), not in an env var. The legacy ADMIN_PASSWORD variable is no longer used.
